{
    "name": "dukstra/nova-multiselect-filter",
    "description": "Multiselect filter for Laravel Nova",
    "keywords": [
        "laravel",
        "nova",
        "multiselect",
        "filter"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/nova": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Dukstra\\NovaMultiselectFilter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dukstra\\NovaMultiselectFilter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox --verbose --stop-on-failure",
        "tag:list": "git tag -l --sort=v:refname | tail",
        "tag:push": "git push --tags && git push"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dukstra\\NovaMultiselectFilter\\FilterServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
